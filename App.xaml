<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="CutTimer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
              全局字体：更纱黑体（Sarasa Gothic）。
              TextBlock / Button / NavigationView 等控件的默认样式里，
              FontFamily 都指向 ContentControlThemeFontFamily 这个主题资源，
              所以在这里覆盖一次就能全应用生效，不用逐个控件去写 FontFamily。
              必须放在 MergedDictionaries **后面** —— 同名的资源以本字典自己的为准。

              用 UI 变体（更纱黑体 UI SC）：它是专门为界面设计的，
              中英混排的基线比编程用的 Gothic 变体更稳。
              机器上没装这个字体时会自动回退到系统默认字体，不会出方块。

              注意：图标字体（Segoe Fluent Icons）在控件上是单独指定的，不受这里影响 ——
              换成中文字体会让所有图标变成方块。
            -->
            <FontFamily x:Key="ContentControlThemeFontFamily">更纱黑体 UI SC</FontFamily>
            <FontFamily x:Key="ControlContentThemeFontFamily">更纱黑体 UI SC</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
