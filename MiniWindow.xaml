<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CutTimer.MiniWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CutTimer 悬浮窗">

    <!-- 整个窗口可长按拖动；亚克力背景由代码设置 -->
    <Grid x:Name="Root" Padding="18,12" Background="Transparent"
          SizeChanged="OnRootSizeChanged"
          PointerPressed="OnRootPointerPressed"
          PointerMoved="OnRootPointerMoved"
          PointerReleased="OnRootPointerReleased"
          PointerCanceled="OnRootPointerReleased"
          PointerCaptureLost="OnRootPointerReleased">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 标题行：卡名 + 置顶 + 关闭 ===== -->
        <Grid Grid.Row="0" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="MiniCut" Grid.Column="0" Text="等待中…"
                       FontSize="13" FontWeight="SemiBold" Opacity="0.85"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

            <Button x:Name="PinBtn" Grid.Column="1"
                    FontFamily="Segoe Fluent Icons" FontSize="13"
                    Width="28" Height="28" Padding="0" CornerRadius="6"
                    Click="OnPinClick"
                    Style="{ThemeResource SubtleButtonStyle}" />

            <Button x:Name="CloseBtn" Grid.Column="2" Content="&#xE711;"
                    FontFamily="Segoe Fluent Icons" FontSize="12"
                    Width="28" Height="28" Padding="0" CornerRadius="6"
                    Click="OnCloseClick"
                    Style="{ThemeResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="关闭悬浮窗" />
        </Grid>

        <!-- ===== 圆环 + 中心时间（尺寸由代码按窗口大小算） ===== -->
        <Grid x:Name="RingHost" Grid.Row="1"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Width="156" Height="156">
            <!-- 轨道 -->
            <Ellipse x:Name="RingTrack" Width="156" Height="156" StrokeThickness="10"
                     Stroke="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <!-- 进度弧（自绘：ProgressRing 的描边太细，做不出时钟那种粗细） -->
            <Path x:Name="RingArc" StrokeThickness="10"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Stroke="{ThemeResource AccentFillColorDefaultBrush}" />

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="1">
                <TextBlock x:Name="MiniSession" Text="0:00"
                           FontSize="30" FontFamily="等距更纱黑体 SC" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="MiniState" Text="本次" FontSize="10.5" Opacity="0.5"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- 起身提醒倒计时小圈：挂在大圆环的左下角，像一枚徽标 -->
            <Grid x:Name="MiniCdHost" Width="52" Height="52"
                  HorizontalAlignment="Left" VerticalAlignment="Bottom"
                  Margin="-6,0,0,-6"
                  ToolTipService.ToolTip="距下次起身提醒">
                <Ellipse x:Name="MiniCdFill" Width="52" Height="52"
                         Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                         Opacity="0.9" />
                <Ellipse x:Name="MiniCdTrack" Width="52" Height="52" StrokeThickness="5"
                         Stroke="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Path x:Name="MiniCdArc" StrokeThickness="5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Stroke="{ThemeResource AccentFillColorDefaultBrush}" />
                <TextBlock x:Name="MiniCdText" Text="30"
                           FontSize="13" FontFamily="等距更纱黑体 SC"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Grid>

        <!-- ===== 信息行 ===== -->
        <Grid Grid.Row="2" Margin="0,10,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Bottom">
                <TextBlock Text="本卡累计" FontSize="10" Opacity="0.5" />
                <TextBlock x:Name="MiniTotal" Text="—" FontSize="13"
                           FontFamily="等距更纱黑体 SC" Opacity="0.75" />
            </StackPanel>

            <!-- 「你的时间」是准的那个数，放大强调 -->
            <StackPanel Grid.Column="1" Spacing="0" HorizontalAlignment="Right">
                <TextBlock Text="其中你的" FontSize="10" Opacity="0.5"
                           HorizontalAlignment="Right" />
                <TextBlock x:Name="MiniMine" Text="0:00:00" FontSize="21"
                           FontFamily="等距更纱黑体 SC" FontWeight="SemiBold"
                           HorizontalAlignment="Right" Margin="0,-2,0,0"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- ===== 作画状态：CSP 图标 + 是否在作画 ===== -->
        <Border Grid.Row="3" Margin="0,12,0,0" CornerRadius="6" Padding="10,6"
                HorizontalAlignment="Center"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <!-- 本机 CSP 的官方图标，不进仓库，构建前提取。
                     缺失时代码里会把它收起来。 -->
                <Image x:Name="AppIcon" Source="ms-appx:///Assets/csp.png"
                       Width="18" Height="18" VerticalAlignment="Center" Opacity="0.35" />
                <TextBlock x:Name="AppText" Text="未在作画" FontSize="12"
                           VerticalAlignment="Center" Opacity="0.55" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
